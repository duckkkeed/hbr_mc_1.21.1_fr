{
	"schemaVersion": 1,
	"id": "hbr_mc",
	"version": "${version}",
	"name": "HBR_MC",
	"description": "This is an example description! Tell everyone what your mod is about!",
	"authors": [
		"duckkkeed"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "MIT",
	"icon": "assets/hbr_mc/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.hbr_mc.HBR_MC"
		],
		"client": [
			"com.hbr_mc.client.HBR_MCClient"
		],
		"fabric-datagen": [
			"com.hbr_mc.datagen.ModDataGenerator"
		]
	},
	"mixins": [
		"hbr_mc.mixins.json",
		{
			"config": "hbr_mc.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
}